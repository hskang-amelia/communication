//
// DDS topic type of the network gateway transport. The frame content is the transport's own wire format
// (see ../core/wire_format.h); DDS only carries it as an opaque octet sequence.
module score_gateway
{
    @final
    struct Frame
    {
        sequence<octet> data;
    };
};
